# App URL (optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (SQLite — no external service required)
DATABASE_URL="file:./dev.db"

# NextAuth secret — a default is baked into the Dockerfile; override in production
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Local file storage (optional). Defaults to /data/uploads in prod, ./data/uploads in dev.
UPLOAD_DIR=""

# Google Cloud Vision API for OCR (optional — manual entry works without it)
# GOOGLE_VISION_API_KEY=""

# Stripe (optional — pricing page works without these)
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_PRICE_ID_MONTHLY="price_..."
# STRIPE_PRICE_ID_YEARLY="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (optional — emails are skipped if unset)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@yourdomain.com"
